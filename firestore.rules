rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields:
    //   - quickAddItems: list (optional) - Cached items for quick addition
    //   - publicProfile: map (optional) - Denormalized public user data
    //     - displayName: string
    //     - firstName: string
    //     - streak: number
    //     - questsCompleted: number
    //     - weeklyXP: number
    //     - level: number
    //     - levelName: string
    //     - friendCode: string
    //     - lastSyncedAt: string
    //
    // Collection: users/{userId}/expenses
    // Document ID: expenseId
    // Fields:
    //   - amount: number
    //   - category: string
    //   - title: string
    //   - timestamp: string
    //   - type: string
    //
    // Collection: friends/{userId}/requests
    // Document ID: requesterId
    // Fields:
    //   - sentAt: string
    //   - displayName: string
    //
    // Collection: friends/{userId}/friends
    // Document ID: friendId
    // Fields:
    //   - addedAt: string
    //   - displayName: string
    //   - publicProfile: map
    //
    // Collection: feed/{userId}/entries
    // Document ID: entryId
    // Fields:
    //   - type: string
    //   - message: string
    //   - emoji: string
    //   - authorName: string
    //   - authorInitial: string
    //   - timestamp: string
    //
    // Collection: global_feed
    // Document ID: auto-generated
    // Fields:
    //   - type: string
    //   - message: string
    //   - emoji: string
    //   - authorName: string
    //   - authorInitial: string
    //   - authorUid: string
    //   - audience: list
    //   - timestamp: string
    //
    // Collection: friendCodes
    // Document ID: string code (e.g., "name#1234")
    // Fields:
    //   - uid: string
    //   - createdAt: string
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasPendingFrom(target, requester) {
      return exists(/databases/$(database)/documents/friends/$(target)/requests/$(requester));
    }

    function validPublicProfile(data) {
      return !('publicProfile' in data) || (
        data.publicProfile is map &&
        (!('displayName' in data.publicProfile) ||
          (data.publicProfile.displayName is string && data.publicProfile.displayName.size() > 0 && data.publicProfile.displayName.size() <= 80)) &&
        (!('firstName' in data.publicProfile) ||
          (data.publicProfile.firstName is string && data.publicProfile.firstName.size() <= 40)) &&
        (!('streak' in data.publicProfile) ||
          (data.publicProfile.streak is number && data.publicProfile.streak >= 0 && data.publicProfile.streak <= 365)) &&
        (!('questsCompleted' in data.publicProfile) ||
          (data.publicProfile.questsCompleted is number && data.publicProfile.questsCompleted >= 0 && data.publicProfile.questsCompleted <= 5000)) &&
        (!('weeklyQuestsCompleted' in data.publicProfile) ||
          (data.publicProfile.weeklyQuestsCompleted is number && data.publicProfile.weeklyQuestsCompleted >= 0 && data.publicProfile.weeklyQuestsCompleted <= 12)) &&
        (!('weeklyXP' in data.publicProfile) ||
          (data.publicProfile.weeklyXP is number && data.publicProfile.weeklyXP >= 0 && data.publicProfile.weeklyXP <= 5000)) &&
        (!('level' in data.publicProfile) ||
          (data.publicProfile.level is number && data.publicProfile.level >= 1 && data.publicProfile.level <= 7)) &&
        (!('levelName' in data.publicProfile) ||
          (data.publicProfile.levelName is string && data.publicProfile.levelName.size() <= 40)) &&
        (!('friendCode' in data.publicProfile) ||
          (data.publicProfile.friendCode is string && data.publicProfile.friendCode.size() <= 20)) &&
        (!('lastSyncedAt' in data.publicProfile) || data.publicProfile.lastSyncedAt is string) &&
        (!('weekMondayKey' in data.publicProfile) ||
          (data.publicProfile.weekMondayKey is string && data.publicProfile.weekMondayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      // Allow authenticated users to read profiles (since public profiles are stored here)
      allow read: if isAuthenticated();
      // Only the user themselves can write their data
      allow create, update: if isOwner(userId) && validPublicProfile(request.resource.data);
      allow delete: if false;

      // User Expenses
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }

      match /private/{doc} {
        allow read, write: if isOwner(userId);
      }

      match /sentRequests/{targetId} {
        // Sender owns this list — full read/write
        allow read, write: if isOwner(userId);
        // Target may delete (cleanup on accept/decline) — but cannot create or read
        allow delete:      if isOwner(targetId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /notificationLog/{dayId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
        allow create, delete: if false;
      }
    }

    // Friends Architecture
    match /friends/{userId} {
      // The parent doc itself isn't generally queried, but allowed for owner
      allow read, write: if isOwner(userId);

      match /requests/{requesterId} {
        // Owner of the inbox and the requester can read and delete
        allow read, delete: if isOwner(userId) || isOwner(requesterId);
        // Only the requester can create the request in the target's inbox
        allow create: if isOwner(requesterId);
        allow update: if false;
      }

      match /friends/{friendId} {
        // Both the owner and the friend can read
        allow read: if isOwner(userId) || isOwner(friendId);
        // Friend edge can only be created when there's a matching pending request.
        allow create: if (isOwner(userId) && hasPendingFrom(userId, friendId))
                      || (isOwner(friendId) && hasPendingFrom(friendId, userId));
        allow update: if false;
        // Both can delete (unfriend)
        allow delete: if isOwner(userId) || isOwner(friendId);
      }
    }

    // Personal Feed
    match /feed/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Global Feed (Shared)
    match /global_feed/{entryId} {
      // Can read if my uid is in the audience array
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.audience);
      // Can create only for my own entries and valid audience scopes.
      allow create: if isAuthenticated()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.audience is list
                    && request.auth.uid in request.resource.data.audience
                    && request.resource.data.audience.size() <= 100;
      // Feed entries are immutable
      allow update, delete: if false;
    }

    // Friend Codes
    match /friendCodes/{code} {
      allow read: if isAuthenticated();
      // Can claim if not exists and the requested uid is me
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Codes are immutable right now
      allow update, delete: if false;
    }

    match /notificationEvents/{eventId} {
      // Server (admin SDK) bypasses these rules; clients are tightly scoped.
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["openedAt"])
                    && request.resource.data.openedAt is timestamp;
      allow create, delete: if false;
    }

    match /devLog/{logId} {
      // Server writes; users can only read/delete their own entries.
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    match /metrics/{docId} {
      // Server-only counters. Clients have no business reading or writing these.
      allow read, write: if false;
    }
  }
}
